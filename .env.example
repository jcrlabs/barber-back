APP_ENV=development
PORT=8080

# Base de datos (o DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD)
DATABASE_URL=postgres://barber:barber@localhost:5432/barber?sslmode=disable

# URL pública del front (los callbacks OAuth cuelgan de aquí)
PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=127.0.0.1/32

# JWT RS256 — genera la clave con `make keys` (queda en .keys/, ignorado por git)
JWT_PRIVATE_KEY_FILE=.keys/jwt.pem
JWT_PRIVATE_KEY=

# Emails que reciben rol admin al iniciar sesión con email verificado (Google/GitHub)
ADMIN_EMAILS=

# OAuth — opcionales; si faltan, el botón no aparece
# Callback: ${PUBLIC_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: ${PUBLIC_URL}/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Avisos de reservas nuevas al admin — opcionales
# ntfy: URL completa del topic (privado y difícil de adivinar). Cada aviso trae botón "Llamar" y "WhatsApp".
NTFY_URL=
NTFY_TOKEN=
# Telegram: token de @BotFather y chat_id del admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reglas de reserva
SHOP_TIMEZONE=Europe/Madrid
SLOT_STEP_MIN=30
BOOKING_LEAD_MIN=60
BOOKING_WINDOW_DAYS=45
CANCEL_WINDOW_MIN=120
MAX_ACTIVE_APPOINTMENTS=3
SEED_DEMO_DATA=true
